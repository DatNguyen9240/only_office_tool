{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "dist",
  "functions": {
    "api/proxy.js": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/api/((?!proxy$).*)",
      "destination": "/api/proxy?path=$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}



