ONLYOFFICE_MAX_DOWNLOAD_BYTES=104857600
API_PUBLIC_URL=http://host.docker.internal:5000/api
STORAGE_QUOTA_BYTES=107374182400

S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
