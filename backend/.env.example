NODE_ENV=development
PORT=3000
WEB_APP_URL=http://localhost:5173

DATABASE_URL=postgresql://meridian:change-me@localhost:5435/meridian_dms

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

ONLYOFFICE_SERVER_URL=http://localhost
ONLYOFFICE_INTERNAL_URL=http://localhost
