NODE_ENV=development
PORT=3000
WEB_APP_URL=http://localhost:5173
SMTP_URL=smtp://username:password@smtp.example.com:587
MAIL_FROM=Meridian DMS <no-reply@example.com>
WEBAUTHN_ORIGIN=http://localhost:5173
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Meridian DMS

DATABASE_URL=postgresql://meridian:change-me@localhost:5435/meridian_dms

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

ONLYOFFICE_SERVER_URL=http://localhost
ONLYOFFICE_INTERNAL_URL=http://localhost
ONLYOFFICE_JWT_SECRET=replace-with-a-dedicated-onlyoffice-secret
ONLYOFFICE_MAX_DOWNLOAD_BYTES=104857600
API_PUBLIC_URL=http://host.docker.internal:5000/api
STORAGE_QUOTA_BYTES=107374182400

S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minio
S3_SECRET_KEY=replace-with-a-strong-minio-password
S3_BUCKET=meridian-documents
S3_FORCE_PATH_STYLE=true
S3_URL_TTL_SECONDS=900
MINIO_METRICS_URL=http://localhost:9000
MINIO_METRICS_TOKEN=
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=replace-with-a-strong-minio-password
REDIS_URL=redis://localhost:6379
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
MALWARE_SCAN_REQUIRED=false
TRASH_RETENTION_DAYS=30
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
TIKA_URL=http://localhost:9998
ELASTICSEARCH_URL=
