generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  EMPLOYEE
  MANAGER
  ADMINISTRATOR
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum DocumentType {
  DOCX
  XLSX
  PPTX
  PDF
  FOLDER
}

enum DocumentStatus {
  READY
  REVIEW
  LOCKED
  DELETED
}

enum PermissionRole {
  VIEWER
  COMMENTER
  EDITOR
  OWNER
}

enum ScanStatus {
  PENDING
  CLEAN
  INFECTED
  FAILED
}

model User {
  id            String               @id @default(cuid())
  email         String               @unique
  name          String
  passwordHash  String?
  department    String?
  role          UserRole             @default(EMPLOYEE)
  status        UserStatus           @default(ACTIVE)
  lastActiveAt  DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  ownedDocuments Document[]          @relation("DocumentOwner")
  permissions   DocumentPermission[]
  versions      DocumentVersion[]    @relation("VersionAuthor")
  auditLogs     AuditLog[]           @relation("AuditActor")
  folders       Folder[]             @relation("FolderOwner")
  refreshSessions RefreshSession[]
  favorites     DocumentFavorite[]
  passkeys      PasskeyCredential[]
  passwordResetTokens PasswordResetToken[]
  webauthnChallenges WebAuthnChallenge[]
  comments      Comment[]
  commentMentions CommentMention[]
  notifications Notification[]
  createdGroups Group[]                @relation("GroupCreator")
  groupMemberships GroupMember[]
  folderPermissions FolderPermission[]
  templates     DocumentTemplate[]
  webhookSubscriptions WebhookSubscription[] @relation("WebhookOwner")
  createdMeetings Meeting[]          @relation("MeetingCreator")
}

model RefreshSession {
  id        String    @id
  userId    String
  tokenHash String
  ip        String?
  userAgent String?
  lastUsedAt DateTime @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Folder {
  id        String    @id @default(cuid())
  name      String
  parentId  String?
  ownerId   String
  parent    Folder?   @relation("FolderTree", fields: [parentId], references: [id])
  children  Folder[]  @relation("FolderTree")
  owner     User      @relation("FolderOwner", fields: [ownerId], references: [id])
  documents Document[]
  permissions FolderPermission[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([parentId])
  @@index([ownerId])
}

model Document {
  id               String               @id @default(cuid())
  name             String
  type             DocumentType
  status           DocumentStatus       @default(READY)
  folderId         String?
  ownerId          String
  starred          Boolean              @default(false)
  version          Int                  @default(1)
  currentVersionId String?              @unique
  folder           Folder?              @relation(fields: [folderId], references: [id])
  owner            User                 @relation("DocumentOwner", fields: [ownerId], references: [id])
  currentVersion   DocumentVersion?     @relation("CurrentDocumentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions         DocumentVersion[]    @relation("DocumentVersions")
  permissions      DocumentPermission[]
  shareLinks       ShareLink[]
  favorites        DocumentFavorite[]
  comments         Comment[]
  uploadIntents    UploadIntent[]
  tags             DocumentTag[]
  metadata         Json?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  deletedAt        DateTime?

  @@index([folderId])
  @@index([ownerId])
  @@index([status])
  @@index([deletedAt])
  @@index([deletedAt, folderId, updatedAt])
  @@index([deletedAt, name])
}

model PasskeyCredential {
  id         String   @id
  userId     String
  publicKey  Bytes
  counter    BigInt   @default(0)
  transports String[]
  deviceType String
  backedUp   Boolean  @default(false)
  name       String?
  createdAt  DateTime @default(now())
  lastUsedAt DateTime?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model WebAuthnChallenge {
  id        String   @id @default(cuid())
  userId    String?
  challenge String
  type      String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model DocumentFavorite {
  id         String   @id @default(cuid())
  documentId String
  userId     String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([documentId, userId])
  @@index([userId, createdAt])
}

model DocumentVersion {
  id           String   @id @default(cuid())
  documentId   String
  version      Int
  objectKey    String
  sizeBytes    BigInt
  checksum     String?
  note         String?
  authorId     String
  document     Document @relation("DocumentVersions", fields: [documentId], references: [id], onDelete: Cascade)
  currentFor   Document? @relation("CurrentDocumentVersion")
  author       User     @relation("VersionAuthor", fields: [authorId], references: [id])
  scanStatus   ScanStatus @default(CLEAN)
  scanMessage  String?
  scannedAt    DateTime?
  textContent  String?
  createdAt    DateTime @default(now())

  @@unique([documentId, version])
  @@index([documentId, createdAt])
}

model DocumentPermission {
  id         String         @id @default(cuid())
  documentId String
  userId     String?
  email      String?
  groupId    String?
  role       PermissionRole
  grantedById String
  document   Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user       User?          @relation(fields: [userId], references: [id])
  group      Group?         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt  DateTime       @default(now())

  @@unique([documentId, email])
  @@unique([documentId, groupId])
  @@index([userId])
  @@index([groupId])
}

model Tag {
  id        String        @id @default(cuid())
  name      String        @unique
  color     String?
  createdAt DateTime      @default(now())
  documents DocumentTag[]
}

model DocumentTag {
  documentId String
  tagId      String
  createdAt  DateTime @default(now())
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([documentId, tagId])
  @@index([tagId])
}

model DocumentTemplate {
  id          String       @id @default(cuid())
  name        String
  description String?
  type        DocumentType
  objectKey   String?
  ownerId     String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  owner       User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
}

model UploadIntent {
  id                String    @id @default(cuid())
  documentId        String
  objectKey         String    @unique
  expectedSizeBytes BigInt
  contentType       String
  expiresAt         DateTime
  completedAt       DateTime?
  createdAt         DateTime  @default(now())
  document          Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([expiresAt, completedAt])
  @@index([documentId])
}

model Group {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   User     @relation("GroupCreator", fields: [createdById], references: [id])
  members     GroupMember[]
  documentPermissions DocumentPermission[]
  folderPermissions FolderPermission[]
}

model GroupMember {
  id        String   @id @default(cuid())
  groupId   String
  userId    String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([groupId, userId])
  @@index([userId])
}

model FolderPermission {
  id          String         @id @default(cuid())
  folderId    String
  userId      String?
  email       String?
  groupId     String?
  role        PermissionRole
  grantedById String
  folder      Folder         @relation(fields: [folderId], references: [id], onDelete: Cascade)
  user        User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  group       Group?         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now())

  @@unique([folderId, email])
  @@unique([folderId, groupId])
  @@index([userId])
  @@index([groupId])
}

model Comment {
  id         String    @id @default(cuid())
  documentId String
  authorId   String
  content    String
  resolvedAt DateTime?
  editedAt   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  document   Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  author     User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  mentions   CommentMention[]

  @@index([documentId, createdAt])
  @@index([authorId])
}

model CommentMention {
  id        String   @id @default(cuid())
  commentId String
  userId    String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([commentId, userId])
  @@index([userId])
}

model Notification {
  id           String    @id @default(cuid())
  userId       String
  type         String
  title        String
  body         String?
  resourceType String?
  resourceId   String?
  readAt       DateTime?
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model WebhookSubscription {
  id          String   @id @default(cuid())
  ownerId     String
  url         String
  secret      String
  events      String[]
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  owner       User     @relation("WebhookOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  deliveries  WebhookDelivery[]

  @@index([ownerId, active])
}

model WebhookDelivery {
  id             String   @id @default(cuid())
  subscriptionId String
  event          String
  payload        Json
  statusCode     Int?
  attempts       Int      @default(0)
  deliveredAt    DateTime?
  nextAttemptAt  DateTime @default(now())
  lastError      String?
  createdAt      DateTime @default(now())
  subscription    WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, nextAttemptAt])
}

model ShareLink {
  id         String         @id @default(cuid())
  documentId String
  tokenHash  String         @unique
  passwordHash String?
  permission PermissionRole @default(VIEWER)
  expiresAt  DateTime?
  createdById String
  document   Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdAt  DateTime       @default(now())
  revokedAt  DateTime?

  @@index([documentId])
}

model AuditLog {
  id           String   @id @default(cuid())
  timestamp    DateTime @default(now())
  actorId      String?
  action       String
  resourceType String
  expiresAt  DateTime?
  createdById String
  document   Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdAt  DateTime       @default(now())
  revokedAt  DateTime?

  @@index([documentId])
}

model AuditLog {
  id           String   @id @default(cuid())
  timestamp    DateTime @default(now())
  actorId      String?
  action       String
  resourceType String
  resourceId   String?
  outcome      String
  ip           String?
  userAgent    String?
  metadata     Json?
  actor        User?    @relation("AuditActor", fields: [actorId], references: [id])

  @@index([timestamp])
  @@index([actorId])
  @@index([resourceType, resourceId])
}

enum MeetingStatus {
  SCHEDULED
  LIVE
  RECORDING
  PROCESSING
  TRANSCRIBING
  ANALYZING
  COMPLETED
  FAILED
}

enum MeetingRecordingType {
  COMPOSITE
  TRACK
}

model Meeting {
  id           String               @id @default(cuid())
  title        String
  roomName     String               @unique
  status       MeetingStatus        @default(SCHEDULED)
  scheduledAt  DateTime?
  startedAt    DateTime?
  endedAt      DateTime?
  duration     Float?
  egressId     String?
  videoObjectKey String?
  peaksObjectKey String?
  errorMessage String?
  createdById  String
  createdBy    User                 @relation("MeetingCreator", fields: [createdById], references: [id], onDelete: Cascade)
  participants MeetingParticipant[]
  recordings   MeetingRecording[]
  tracks       MeetingTrack[]
  transcripts  MeetingTranscriptSegment[]
  analysis     MeetingAnalysis?
  jobs         MeetingProcessingJob[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([createdById])
  @@index([status])
  @@index([createdAt])
}

model MeetingParticipant {
  id            String               @id @default(cuid())
  meetingId     String
  participantId String               // LiveKit participant identity
  name          String
  audioObjectKey String?
  joinedAt      DateTime             @default(now())
  leftAt        DateTime?
  meeting       Meeting              @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  tracks        MeetingTrack[]
  transcripts   MeetingTranscriptSegment[]

  @@unique([meetingId, participantId])
  @@index([meetingId])
}

model MeetingRecording {
  id         String               @id @default(cuid())
  meetingId  String
  egressId   String
  type       MeetingRecordingType @default(COMPOSITE)
  objectKey  String
  sizeBytes  BigInt?
  duration   Float?
  status     String               @default("ready")
  meeting    Meeting              @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  createdAt  DateTime             @default(now())

  @@index([meetingId])
  @@index([egressId])
}

model MeetingTrack {
  id            String             @id @default(cuid())
  meetingId     String
  participantId String
  trackId       String
  objectKey     String
  duration      Float?
  meeting       Meeting            @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  participant   MeetingParticipant @relation(fields: [meetingId, participantId], references: [meetingId, participantId], onDelete: Cascade)
  createdAt     DateTime           @default(now())

  @@unique([meetingId, trackId])
  @@index([meetingId])
}

model MeetingTranscriptSegment {
  id              Int                 @id @default(autoincrement())
  meetingId       String
  participantId   String
  participantName String
  trackId         String?
  startTime       Float               // Start time in seconds relative to meeting start
  endTime         Float               // End time in seconds relative to meeting start
  text            String
  confidence      Float?
  words           Json?
  meeting         Meeting             @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  participant     MeetingParticipant? @relation(fields: [meetingId, participantId], references: [meetingId, participantId], onDelete: SetNull)
  createdAt       DateTime            @default(now())

  @@index([meetingId, startTime])
  @@index([participantId])
}

model MeetingAnalysis {
  id          String            @id @default(cuid())
  meetingId   String            @unique
  title       String
  summary     String
  topics      Json              // MeetingTopic[]
  meeting     Meeting           @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  decisions   MeetingDecision[]
  actionItems MeetingActionItem[]
  risks       MeetingRisk[]
  questions   MeetingQuestion[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model MeetingDecision {
  id                      String          @id @default(cuid())
  analysisId              String
  content                 String
  decidedByParticipantIds String[]
  evidenceSegmentIds      Int[]
  analysis                MeetingAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId])
}

model MeetingActionItem {
  id                    String          @id @default(cuid())
  analysisId            String
  task                  String
  assigneeParticipantId String?
  assigneeName          String?
  deadline              String?
  status                String          @default("open")
  confidence            Float           @default(1.0)
  evidenceSegmentIds    Int[]
  analysis              MeetingAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId])
}

model MeetingRisk {
  id                 String          @id @default(cuid())
  analysisId         String
  risk               String
  mitigation         String?
  evidenceSegmentIds Int[]
  analysis           MeetingAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId])
}

model MeetingQuestion {
  id                 String          @id @default(cuid())
  analysisId         String
  question           String
  evidenceSegmentIds Int[]
  analysis           MeetingAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId])
}

model MeetingProcessingJob {
  id        String   @id @default(cuid())
  meetingId String
  jobType   String
  status    String   @default("pending")
  attempts  Int      @default(0)
  error     String?
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([meetingId, jobType])
  @@index([status])
}
